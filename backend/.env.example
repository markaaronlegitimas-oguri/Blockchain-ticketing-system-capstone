PORT=3000

# Supabase project (Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-secret-server-key

# Sepolia network access and the deployed EventTicket contract
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-KEY
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Wallet that deployed the contract (the organizer). Used to issue and validate tickets. Never commit it.
SEPOLIA_PRIVATE_KEY=0xyour-private-key
# Only used by the buyTicket.js command-line test script
BUYER_TEST_PRIVATE_KEY=0xyour-test-buyer-private-key
